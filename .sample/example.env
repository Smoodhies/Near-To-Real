# ==========================================
# DATABASE
# ==========================================
MONGODB_URI="mongodb+srv://password:username@realtonear.ryupy2m.mongodb.net/"
MONGODB_DB_NAME=db_name

# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development

API_HOST=0.0.0.0
API_PORT=3000


# ==========================================
# AWS
# ==========================================

AWS_REGION=


# ==========================================
# INPUT S3
# ==========================================

INPUT_S3_BUCKET=



# Optional:
# Only process objects under this prefix


S3_INPUT_PREFIX=what_ever_dir_name or use this / or empty


# ==========================================
# OUTPUT S3
# ==========================================

OUTPUT_S3_BUCKET=your_bucket_name

S3_OUTPUT_PREFIX=output/


# ==========================================
# SQS
# ==========================================

SQS_QUEUE_URL=

# Long polling
SQS_WAIT_TIME_SECONDS=20

# How long a message stays invisible while processing
SQS_VISIBILITY_TIMEOUT_SECONDS=1800

# Number of messages fetched per poll
SQS_MAX_MESSAGES=10


# ==========================================
# WORKER
# ==========================================

# Maximum number of media jobs processed simultaneously
WORKER_CONCURRENCY=2


# ==========================================
# STORAGE / WORKSPACE
# ==========================================

OUTPUT_DIR=./output

TEMP_DIR=./output/tmp

WORKSPACE_DIR=./workspace


# ==========================================
# MEDIA PROCESSING
# ==========================================

GENERATE_WAV=true

GENERATE_MP3=true

GENERATE_VIDEO_ONLY=true

EXTRACT_SUBTITLES=true

FFMPEG_TIMEOUT_MS=1800000


# ==========================================
# API SECURITY
# ==========================================

FREE_API_KEY=
PAID_API_KEY=

# ==========================================
# FREE API PLAN
# ==========================================

FREE_RATE_LIMIT_PER_MINUTE=10

FREE_MAX_CONCURRENT_UPLOADS=1

FREE_MAX_UPLOAD_BYTES=104857600

# ==========================================
# PAID API PLAN
# ==========================================

PAID_RATE_LIMIT_PER_MINUTE=100

PAID_MAX_CONCURRENT_UPLOADS=3

PAID_MAX_UPLOAD_BYTES=524288000





